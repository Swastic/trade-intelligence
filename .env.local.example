# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Groq free AI (console.groq.com) ──────────────────────────────────────────
GROQ_API_KEY=gsk_your-groq-key-here

# ── News refresh secret (make up any random string) ──────────────────────────
# Call /api/news-refresh with header: x-refresh-secret: <this value>
# Set up a daily cron on cron-job.org to call it automatically (free)
NEWS_REFRESH_SECRET=change-this-to-a-random-string

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
